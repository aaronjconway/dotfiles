set shellopts '-eu'
set ifs "\n"

set hidden
set incsearch
set incfilter
set smartcase

set preview
set info time
set sortby natural

set ratios '1:2:3'
set timefmt '2006-01-02 15:04:05 -0700'
set previewer ~/.config/lf/lf-ueberzug-previewer
set cleaner ~/.config/lf/lf-ueberzug-cleaner

map D trash
map . :filter
map <esc> :quit


# create directory/file
map ad push $mkdir<space>
map af push $touch<space>

map sn :{{ set sortby natural;set reverse!; set info size; set preview; }}
map ss :{{ set sortby size; set info size; set preview; }}
map st :{{ set sortby time; set reverse; set info time; set preview; }}

cmd mkdir %[ -n "${1}" ] && mkdir -p ${@} || echo "Argument needed"
cmd mkfile %[ -n "${1}" ] && touch ${@} || echo "Argument needed"

map e extract
cmd extract ${{

        set -f
        case $f in
            *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f ;;
            *.tar.gz|*.tgz) tar xzvf $f ;;
            *.tar.xz|*.txz) tar xJvf $f ;;
            *.zip) unzip $f ;;
            *.rar) unrar x $f ;;
            *.7z) 7z x $f ;;
        esac
}}

# map <delete> trash
map D trash
cmd trash %set -f; mv --backup=numbered -t ~/.trash -- $fx

# define a custom 'delete' command
map <delete> delete
cmd delete ${{
        set -f
        printf "$fx\n"
        printf "delete? [y/N] "
        read ans
        [ "$ans" = "y" ] && rm -rf $fx
}}



map <enter> open
cmd open &{{
        case $(file --mime-type -Lb $f) in
            application/pdf) for f in $fx; do $OPENER $f > /dev/null 2> /dev/null & done ;;
            application/octet-stream) for f in $fx; do $OPENER $f > /dev/null 2> /dev/null & done ;;
            inode/x-empty | text/* | */json | */html | application/*) lf -remote "send $id \$$EDITOR \$fx" ;;
            *) for f in $fx; do $OPENER $f > /dev/null 2> /dev/null & done ;;
        esac
}}

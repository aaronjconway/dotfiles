set shellopts '-eu'
set ifs "\n"

set hidden
set incsearch
set incfilter
set smartcase

set preview
set info time
set sortby natural

set ratios '1:2:3'
set timefmt '2006-01-02 15:04:05 -0700'
set previewer ~/.config/lf/previewer

map D trash
map . :filter
map <esc> :quit

# create directory/file
map ad push $mkdir<space>
map af push $touch<space>

map sn :{{ set sortby natural;set reverse!; set info size; set preview; }}
map ss :{{ set sortby size; set info size; set preview; }}
map st :{{ set sortby time; set reverse; set info time; set preview; }}

cmd mkdir %[ -n "${1}" ] && mkdir -p ${@} || echo "Argument needed"
cmd mkfile %[ -n "${1}" ] && touch ${@} || echo "Argument needed"

map e extract
cmd extract ${{

        set -f
        case $f in
            *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f ;;
            *.tar.gz|*.tgz) tar xzvf $f ;;
            *.tar.xz|*.txz) tar xJvf $f ;;
            *.zip) unzip $f ;;
            *.rar) unrar x $f ;;
            *.7z) 7z x $f ;;
        esac
}}

# map <delete> trash
map D trash
cmd trash %set -f; mv --backup=numbered -t ~/.trash -- $fx

# define a custom 'delete' command
map <delete> delete
cmd delete ${{
        set -f
        printf "$fx\n"
        printf "delete? [y/N] "
        read ans
        [ "$ans" = "y" ] && rm -rf $fx
}}



map <enter> open

cmd open &{{
    mime="$(file --mime-type -Lb -- "$f")"

    case "$mime" in
        # Text/code/config/logs/etc → vim
        text/* | \
        */json | \
        */xml | \
        */javascript | \
        */x-shellscript | \
        application/x-* | \
        application/json | \
        application/xml | \
        inode/x-empty)
            lf -remote "send $id \$$EDITOR \$fx"
            ;;

        # Video/audio/images/pdf → system opener
        video/* | \
        audio/* | \
        image/* | \
        application/pdf)
            for f in $fx; do
                "$OPENER" "$f" >/dev/null 2>/dev/null &
            done
            ;;

        # Archives → vim (usually useful to inspect)
        application/zip | \
        application/x-tar | \
        application/gzip | \
        application/x-bzip2 | \
        application/x-xz)
            lf -remote "send $id \$$EDITOR \$fx"
            ;;

        # Unknown binaries → opener
        application/octet-stream)
            for f in $fx; do
                "$OPENER" "$f" >/dev/null 2>/dev/null &
            done
            ;;

        # Fallback → vim
        *)
            lf -remote "send $id \$$EDITOR \$fx"
            ;;
    esac
}}

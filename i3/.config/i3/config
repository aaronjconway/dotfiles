exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id ~/.config/i3/capslock.sh
exec --no-startup-id nm-applet
exec --no-startup-id xset s off
exec --no-startup-id xset -dpms

font pango:monospace 14
for_window [class=".*"] layout tabbed
default_border pixel 1

set $mod Mod1

bindsym $mod+Tab exec /home/aaron/.local/bin/i3-cycle right 
bindsym $mod+Shift+Tab exec /home/aaron/.local/bin/i3-cycle left
bindsym $mod+d exec --no-startup-id dmenu_run -fn 'pango:pixelsize=18'
bindsym $mod+Shift+r restart
bindsym $mod+Return exec st
bindsym $mod+w layout toggle tabbed splith
bindsym $mod+Shift+q kill

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

bar {
	position top
	status_command i3status
}

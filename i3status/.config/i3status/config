general {
        output_format = "i3bar"
        colors = true
        interval = 2
}

order += "wireless wlp0s20f3"
order += "battery 0"
order += "tztime local"

wireless wlp0s20f3 {
        format_up = "%essid (%quality ) %bitrate %frequency %ip"
        format_down = "offline"
		format_bitrate = "%05.2f"
}

battery 0 {
        format = "%status %percentage %emptytime"
        format_down = "No battery"
        status_chr = "CHR"
        status_bat = "BAT"
        status_unk = "UNK"
        status_full = "FULL"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
}

tztime local {
        format = "%a %B %-d %H:%M:%S %Z"
}
